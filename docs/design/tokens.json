        },
        "playingCards": {
          "primary": "#B4232A",
          "onPrimary": "#FFFFFF",
          "accent": "#28333B",
          "surface": "#FFF0F0"
        }
      }
    },
    "dark": {
      "background": "#111416",
      "surface": "#181C1F",
      "surfaceMuted": "#22282C",
      "surfaceInset": "#101619",
      "surfaceElevated": "#293036",
      "textPrimary": "#F4F6F7",
      "textSecondary": "#BEC6CC",
      "textDisabled": "#7F8991",
      "border": "#46515A",
      "borderStrong": "#697680",
      "brand": "#79CBE3",
      "onBrand": "#062630",
      "focus": "#79D4F2",
      "success": "#72D3A3",
      "successSurface": "#173528",
      "warning": "#F1C46B",
      "warningSurface": "#3A2C12",
      "error": "#FF9A90",
      "errorSurface": "#3C201E",
      "info": "#8BD3F7",
      "infoSurface": "#17313E",
      "overlay": "#000000B8",
      "tools": {
        "tarot": {
          "primary": "#C7A9EA",
          "onPrimary": "#24162F",
          "accent": "#E4BC63",
          "surface": "#2A2034"
        },
        "liuyao": {
          "primary": "#8CC9AB",
          "onPrimary": "#10271D",
          "accent": "#D8BE8A",
          "surface": "#1D2A24"
        },
        "d20": {
          "primary": "#75D2E3",
          "onPrimary": "#092A31",
          "accent": "#8CB7F0",
          "surface": "#172A31"
        },
        "coin": {
          "primary": "#F2B65D",
          "onPrimary": "#30200B",
          "accent": "#CDB38E",
          "surface": "#30251A"
        },
        "playingCards": {
          "primary": "#FF9CA5",
          "onPrimary": "#321318",
          "accent": "#C5D0D8",
          "surface": "#321C20"
        }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": "system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, PingFang SC, Noto Sans CJK SC, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Consolas, Liberation Mono, monospace"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 650,
      "bold": 700
    },
    "styles": {
      "display": {
        "fontFamily": "sans",
        "fontSize": 40,
        "lineHeight": 48,
        "fontWeight": 700,
        "letterSpacing": -0.4
      },
      "headlineLarge": {
        "fontFamily": "sans",
        "fontSize": 32,
        "lineHeight": 40,
        "fontWeight": 700,
        "letterSpacing": -0.2
      },
      "headlineMedium": {
        "fontFamily": "sans",
        "fontSize": 28,
        "lineHeight": 36,
        "fontWeight": 700,
        "letterSpacing": 0
      },
      "titleLarge": {
        "fontFamily": "sans",
        "fontSize": 22,
        "lineHeight": 30,
        "fontWeight": 650,
        "letterSpacing": 0
      },
      "titleMedium": {
        "fontFamily": "sans",
        "fontSize": 18,
        "lineHeight": 26,
        "fontWeight": 650,
        "letterSpacing": 0
      },
      "bodyLarge": {
        "fontFamily": "sans",
        "fontSize": 16,
        "lineHeight": 24,
        "fontWeight": 400,
        "letterSpacing": 0
      },
      "bodyMedium": {
        "fontFamily": "sans",
        "fontSize": 14,
        "lineHeight": 20,
        "fontWeight": 400,
        "letterSpacing": 0
      },
      "labelLarge": {
        "fontFamily": "sans",
        "fontSize": 14,
        "lineHeight": 20,
        "fontWeight": 650,
        "letterSpacing": 0.1
      },
      "labelSmall": {
        "fontFamily": "sans",
        "fontSize": 12,
        "lineHeight": 16,
        "fontWeight": 600,
        "letterSpacing": 0.1
      },
      "mono": {
        "fontFamily": "mono",
        "fontSize": 14,
        "lineHeight": 20,
        "fontWeight": 500,
        "letterSpacing": 0
      }
    }
  },
  "spacing": {
    "0": 0,
    "0.5": 4,
    "1": 8,
    "1.5": 12,
    "2": 16,
    "3": 24,
    "4": 32,
    "5": 40,
    "6": 48,
    "8": 64
  },
  "radii": {
    "none": 0,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "full": 999
  },
  "borders": {
    "default": 1,
    "selected": 2,
    "focus": 2,
    "focusOffset": 2,
    "graphic": 2
  },
  "shadows": {
    "light": {
      "none": "none",
      "sm": "0 1px 2px rgba(20, 24, 27, 0.06), 0 4px 12px rgba(20, 24, 27, 0.04)",
      "md": "inset 0 1px 0 rgba(255, 255, 255, 0.80), 0 12px 32px rgba(20, 24, 27, 0.10)",
      "lg": "inset 0 1px 0 rgba(255, 255, 255, 0.84), 0 24px 64px rgba(20, 24, 27, 0.16)"
    },
    "dark": {
      "none": "none",
      "sm": "0 1px 2px rgba(0, 0, 0, 0.32), 0 4px 12px rgba(0, 0, 0, 0.18)",
      "md": "inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 14px 36px rgba(0, 0, 0, 0.42)",
      "lg": "inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 28px 72px rgba(0, 0, 0, 0.56)"
    }
  },
  "materials": {
    "textureOpacityMax": 0.012,
    "texturePixelSize": 1,
    "edgeHighlightWidth": 1,
    "backdropBlur": 0,
    "toolThemeAreaMax": 0.16,
    "saturatedAccentAreaMax": 0.06
  },
  "motion": {
    "duration": {
      "instant": 0,
      "press": 90,
      "reduced": 80,
      "base": 180,
      "complete": 240,
      "generate": 360,
      "reveal": 640,
      "ritual": 960
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "generate": "cubic-bezier(0.4, 0, 0.2, 1)",
      "reveal": "cubic-bezier(0.16, 1, 0.3, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "linear": "linear"
    },
    "states": {
      "press": {
        "duration": 90,
        "easing": "cubic-bezier(0.2, 0, 0, 1)",
        "translateY": [0, 1],
        "scale": [1, 0.985],
        "blur": [0, 0],
        "particleMax": 0
      },
      "generate": {
        "duration": 360,
        "easing": "cubic-bezier(0.4, 0, 0.2, 1)",
        "translateY": [0, 0],
        "scale": [0.985, 1],
        "blur": [0, 0.6, 0],
        "particleMax": 0
      },
      "reveal": {
        "duration": 640,
        "easing": "cubic-bezier(0.16, 1, 0.3, 1)",
        "translateY": [12, 0],
        "scale": [0.96, 1],
        "blur": [8, 0],
        "particleMax": 12,
        "particleSizeMax": 4,
        "particleTravelMax": 16,
        "particleLifetimeMax": 480
      },
      "complete": {
        "duration": 240,
        "easing": "cubic-bezier(0.2, 0, 0, 1)",
        "translateY": [4, 0],
        "scale": [1.02, 1],
        "blur": [0, 0],
        "particleMax": 8
      },
      "reduced": {
        "duration": 80,
        "easing": "linear",
        "translateY": [0, 0],
        "scale": [1, 1],
        "blur": [0, 0],
        "particleMax": 0,
        "allowedProperties": [
          "opacity"
        ]
      }
    },
    "toolLimits": {
      "tarotFlipDegrees": 90,
      "tarotCardDuration": 480,
      "tarotStagger": 80,
      "liuyaoRotationDegrees": 180,
      "liuyaoLineTravel": 8,
      "diceRotationDegrees": 6,
      "diceStaggerMax": 24,
      "coinRotationDegrees": 720,
      "coinLift": 48,
      "coinApex": 64,
      "coinSettleBounce": 2,
      "playingCardShuffleTravel": 8,
      "playingCardShuffleRotation": 2,
      "playingCardDrawTravel": 40,
      "playingCardDrawRotation": 4,
      "playingCardStagger": 90
    },
    "toolProfiles": {
      "tarot": {
        "press": 90,
        "generate": 360,
        "reveal": 960,
        "complete": 240,
        "reduced": 80
      },
      "liuyao": {
        "press": 90,
        "generate": 360,
        "reveal": 640,
        "complete": 240,
        "reduced": 80
      },
      "d20": {
        "press": 90,
        "generate": 360,
        "reveal": 640,
        "complete": 240,
        "reduced": 80
      },
      "coin": {
        "press": 90,
        "generate": 120,
        "reveal": 720,
        "complete": 240,
        "reduced": 80,
        "keyframes": {
          "liftEnd": 180,
          "flipEnd": 540,
          "settleEnd": 720
        }
      },
      "playingCards": {
        "press": 90,
        "generate": 520,
        "reveal": 640,
        "complete": 240,
        "reduced": 80
      }
    },
    "interruption": {
      "skipToCompleteMax": 80,
      "resumeGeneratedState": "complete",
      "resumeGeneratingState": "generating",
      "replayOnResume": false,
      "cancelParticlesOnHide": true
    }
  },
  "haptics": {
    "enabledByDefault": true,
    "userCanDisable": true,
    "reducedMotionIndependent": true,
    "staticNavigation": "none",
    "android": {
      "selection": "selectionClick",
      "commit": "mediumImpact",
      "firstReveal": "selectionClick",
      "complete": "lightImpact",
      "error": "none",
      "perItemFeedback": false,
      "defaultMaxPerRandomAction": 3,
      "liuyaoMaxPerLine": 1,
      "liuyaoFinalCompleteMax": 1
    },
    "web": {
      "capability": "navigator.vibrate",
      "requiresUserSetting": true,
      "requiresVisiblePage": true,
      "requiresUserActivation": true,
      "requiresPlatformPermissionOrPolicy": true,
      "unsupportedBehavior": "no-op",
      "rejectedBehavior": "no-op",
      "duration": {
        "commit": 12,
        "firstReveal": 8,
        "complete": 10
      }
    },
    "interruption": {
      "cancelPendingOnHide": true,
      "replayOnResume": false
    }
  },
  "breakpoints": {
    "small": 0,
    "tablet": 600,
    "desktop": 1024,
    "wide": 1440
  },
  "components": {
    "AppNavShell": {
      "mobileItemCount": 4,
      "desktopItemCount": 4,
      "mobileHeight": 64,
      "desktopWidth": 240,
      "desktopCompactWidth": 88
    },
    "AppToolScaffold": {
      "mobileGutter": 16,
      "tabletGutter": 24,
      "desktopGutter": 32,
      "columnGap": 24,
      "formMaxWidth": 640
    },
    "AppButton": {
      "minHeight": 48,
      "horizontalPadding": 16,
      "radius": 12,
      "focusWidth": 2,
      "focusOffset": 2,
      "pressScale": 0.985,
      "pressTranslateY": 1
    },
    "AppStepper": {
      "controlSize": 48,
      "inputMinWidth": 88,
      "repeatDelay": 500,
      "repeatInterval": 120
    },
    "AppSegmentedControl": {
      "minTarget": 48,
      "maxInlineOptions": 4,
      "selectedBorder": 2,
      "largeTextFallback": "vertical-radio-cards"
    },
    "AppResultCard": {
      "padding": 24,
      "radius": 24,
      "surfaceLevel": "raised",
      "processDefaultExpanded": false
    },
    "AppGenerationStateView": {
      "stageMinHeight": 240,
      "stageMaxHeightSmall": 320,
      "stateContract": [
        "press",
        "generate",
        "reveal",
        "complete",
        "reduced"
      ],
      "resultMustBeFrozenBeforeReveal": true,
      "animationMayAccessRandomSource": false
    }
  },
  "moduleUiExtension": {
    "allowed": [
      "ToolSemanticTheme",
      "ToolVisualPrimitive",
      "ToolInputFields",
      "ToolOutcomeSummaryRenderer"
    ],
    "visualPrimitives": [
      "TarotCardPrimitive",
      "LiuyaoLinePrimitive",
      "DicePrimitive",
      "CoinPrimitive",
      "PlayingCardPrimitive"
    ],
    "mayOverrideSharedButton": false,
    "mayOverrideSharedNavigation": false,
    "mayAccessRandomSource": false
  },
  "accessibility": {
    "minimumTarget": 48,
    "largeTextScale": 2,
    "focusWidth": 2,
    "focusOffset": 2,
    "resultMeaningMayUseColorOnly": false,
    "motionRequiredForCompletion": false
  },
  "layout": {
    "viewportReferences": {
      "mobile": {
        "width": 360,
        "height": 800
      },
      "desktop": {
        "width": 1440,
        "height": 900
      }
    },
    "pageGutter": {
      "mobile": 16,
      "tablet": 24,
      "desktop": 32
    },
    "contentMaxWidth": 1200,
    "desktopInnerMaxWidth": 1120,
    "formMaxWidth": 640,
    "navigationRailWidth": 240,
    "navigationRailCompactWidth": 88,
    "historyFilterWidth": 280,
    "columnGap": 24,
    "touchTargetMin": 48,
    "bottomNavigationHeight": 64
  },
  "icons": {
    "size": {
      "sm": 16,
      "md": 24,
      "lg": 32
    },
    "strokeWidth": 2
  }
}
